# Docker Compose (منفذ 5433) — فعّل هذا السطر إذا شغّلت docker compose:
DATABASE_URL="postgresql://itsal:itsal_dev@localhost:5433/itsalplatform?schema=public"
# PostgreSQL محلي (منفذ 5432):
# DATABASE_URL="postgresql://itsal:itsal_dev@localhost:5432/itsalplatform?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3001"

# JWT session signing — إلزامي في production (NODE_ENV=production)
# Generate: openssl rand -base64 48
SESSION_SECRET="change-me-in-production"

# Email notifications (optional in local — missing vars skip send gracefully)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zaad.org

