generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RequestStatus {
  Pending_Manager
  Approved_Pending_Assignment
  In_Progress
  Completed
  Archived
}

enum EmployeeRole {
  EMPLOYEE
  SECTION_MANAGER
  DIRECTOR
}

enum AdministrationKind {
  INTERNAL
  EXTERNAL
}

enum GrantStatus {
  Open
  Closed
}

enum GrantStageStatus {
  Pending
  Done
}

/**
 * Top-level org unit (إدارة). INTERNAL = إدارة الاتصال المؤسسي that owns the
 * handling sections (Department). EXTERNAL = requesting administrations whose
 * employees submit requests; managerEmail is the submitter's line manager.
 */
model Administration {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  managerEmail      String
  kind              AdministrationKind     @default(EXTERNAL)
  isActive          Boolean                @default(true)
  departments       Department[]
  requesterRequests CommunicationRequest[] @relation("RequesterAdministration")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([isActive])
  @@index([kind])
}

model Department {
  id               String                 @id @default(cuid())
  name             String
  slug             String                 @unique
  managerEmail     String
  receptionToken   String?                @unique
  isActive         Boolean                @default(true)
  administrationId String?
  administration   Administration?        @relation(fields: [administrationId], references: [id])
  requestTypes     RequestType[]
  requests         CommunicationRequest[]
  requestForms     RequestForm[]
  visitorLogs      ReceptionVisitorLog[]
  employees        CommEmployee[]         @relation("EmployeeDepartment")
  grants           Grant[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([isActive])
  @@index([administrationId])
}

model RequestType {
  id                String                 @id @default(cuid())
  name              String
  slug              String                 @unique
  description       String               @default("")
  requiresVisitDate Boolean                @default(false)
  isActive          Boolean                @default(true)
  departmentId      String?
  department        Department?            @relation(fields: [departmentId], references: [id])
  routingRules      RoutingRule[]
  requests          CommunicationRequest[]
  requestForms      RequestForm[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([isActive])
  @@index([departmentId])
}

model RoutingRule {
  id            String      @id @default(cuid())
  requestTypeId String
  requestType   RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      CommEmployee @relation(fields: [employeeId], references: [id])
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([requestTypeId, employeeId])
  @@index([requestTypeId])
  @@index([employeeId])
}

model CommEmployee {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  phoneNumber       String?               @unique
  passwordHash      String
  role              EmployeeRole          @default(EMPLOYEE)
  isActive          Boolean               @default(true)
  departmentId      String?
  department        Department?           @relation("EmployeeDepartment", fields: [departmentId], references: [id])
  assignedRequests  CommunicationRequest[] @relation("AssignedEmployee")
  assignmentHistory AssignmentHistory[]
  routingRules      RoutingRule[]
  notifications     Notification[]
  passwordResets    PasswordResetToken[]
  visitorLogs       ReceptionVisitorLog[] @relation("MarkedByReception")
  attendanceEvents  AttendanceEvent[]     @relation("AttendanceEventCreator")
  grantsCreated     Grant[]               @relation("GrantCreator")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([isActive])
  @@index([role])
  @@index([departmentId])
}

model Notification {
  id          String       @id @default(cuid())
  recipientId String
  recipient   CommEmployee @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  link        String?
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([recipientId])
  @@index([readAt])
  @@index([createdAt])
}

model CommunicationRequest {
  id                 String              @id @default(cuid())
  title              String
  description        String
  requiredDate       DateTime
  contactEmail       String
  contactPhone       String
  managerEmail       String
  requesterManagerEmail     String?
  requesterAdministrationId String?
  requesterAdministration   Administration? @relation("RequesterAdministration", fields: [requesterAdministrationId], references: [id])
  departmentId       String
  department         Department          @relation(fields: [departmentId], references: [id])
  requestTypeId      String
  requestType        RequestType         @relation(fields: [requestTypeId], references: [id])
  approvalToken      String              @unique
  approvalTokenExpiresAt DateTime?
  status             RequestStatus       @default(Pending_Manager)
  assignedEmployeeId String?
  assignedEmployee   CommEmployee?       @relation("AssignedEmployee", fields: [assignedEmployeeId], references: [id])
  approvedAt         DateTime?
  assignedAt         DateTime?
  completedAt        DateTime?
  proofFileUrl       String?
  visitDate          DateTime?
  visitAttended      Boolean?
  visitMarkedAt      DateTime?
  assignmentHistory  AssignmentHistory[]
  statusHistory      StatusHistory[]
  hospitalityBooking HospitalityBooking?
  visitorLogs        ReceptionVisitorLog[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([status])
  @@index([approvalToken])
  @@index([assignedEmployeeId])
  @@index([departmentId])
  @@index([requesterAdministrationId])
  @@index([requestTypeId])
  @@index([createdAt])
  @@index([visitDate])
}

/** Cumulative visitor log — aligned with approved Apps Script visitor sheet. */
model ReceptionVisitorLog {
  id             String                @id @default(cuid())
  visitorName    String
  visitorPhone   String
  organization   String
  visitType      String
  visitTarget    String
  reason         String                @default("")
  visitTimeSlot  String
  visitAt        DateTime
  departmentId   String?
  department     Department?           @relation(fields: [departmentId], references: [id])
  requestId      String?
  request        CommunicationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  markedById     String?
  markedBy       CommEmployee?         @relation("MarkedByReception", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([visitAt])
  @@index([departmentId])
  @@index([requestId])
  @@index([visitorPhone])
  @@index([visitType])
  @@index([visitTimeSlot])
  @@index([createdAt])
}

/** Meeting / job-interview attendance lists for high headcount check-in. */
model AttendanceEvent {
  id          String               @id @default(cuid())
  title       String
  kind        String
  scheduledAt DateTime
  notes       String               @default("")
  createdById String?
  createdBy   CommEmployee?        @relation("AttendanceEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attendees   AttendanceAttendee[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([scheduledAt])
  @@index([kind])
}

model AttendanceAttendee {
  id          String          @id @default(cuid())
  eventId     String
  event       AttendanceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  phone       String          @default("")
  attended    Boolean         @default(false)
  checkedInAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([eventId])
  @@index([attended])
}

model AssignmentHistory {
  id         String               @id @default(cuid())
  requestId  String
  request    CommunicationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId String
  employee   CommEmployee         @relation(fields: [employeeId], references: [id])
  assignedBy String?
  note       String?
  assignedAt DateTime             @default(now())
  createdAt  DateTime             @default(now())

  @@index([requestId])
  @@index([employeeId])
}

model StatusHistory {
  id         String               @id @default(cuid())
  requestId  String
  request    CommunicationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus RequestStatus?
  toStatus   RequestStatus
  changedBy  String?
  note       String?
  changedAt  DateTime             @default(now())
  createdAt  DateTime             @default(now())

  @@index([requestId])
  @@index([toStatus])
}

model HospitalityBooking {
  id             String                @id @default(cuid())
  requesterName  String
  requesterEmail String
  requesterPhone String                @default("")
  roomName       String
  meetingDate    DateTime
  startTime      String
  endTime        String
  attendeesCount Int
  notes          String                @default("")
  cateringRequests String              @default("")
  requestId      String?               @unique
  request        CommunicationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([meetingDate])
  @@index([requestId])
}

model PasswordResetToken {
  id         String       @id @default(cuid())
  token      String       @unique
  employeeId String
  employee   CommEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime     @default(now())

  @@index([employeeId])
  @@index([expiresAt])
}

model PlatformModule {
  id        String   @id @default(cuid())
  key       String   @unique
  isEnabled Boolean  @default(true)
  sortOrder Int      @default(0)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([sortOrder])
}

model RequestForm {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  isPublished    Boolean      @default(false)
  isDefault      Boolean      @default(false)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  requestTypeId  String?
  requestType    RequestType? @relation(fields: [requestTypeId], references: [id])
  pageTitle      String       @default("جمعية الزاد")
  pageSubtitle   String       @default("تقديم طلب")
  introText      String       @default("")
  submitLabel    String       @default("تقديم الطلب")
  successTitle   String       @default("تم تقديم الطلب بنجاح")
  successMessage String       @default("سيُرسل رابط الموافقة للمدير المباشر تلقائياً.")
  fields         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([isPublished])
  @@index([departmentId])
  @@index([requestTypeId])
}

/**
 * Grant (منحة) tracked by تنمية الموارد المالية from intake to closure, with
 * manually-updated follow-up stages (or a single closure stage when none set).
 */
model Grant {
  id           String       @id @default(cuid())
  title        String
  donorName    String
  amount       Float
  details      String       @default("")
  stageCount   Int          @default(0)
  status       GrantStatus  @default(Open)
  departmentId String?
  department   Department?  @relation(fields: [departmentId], references: [id])
  createdById  String?
  createdBy    CommEmployee? @relation("GrantCreator", fields: [createdById], references: [id], onDelete: SetNull)
  stages       GrantStage[]
  closedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([createdAt])
}

model GrantStage {
  id        String           @id @default(cuid())
  grantId   String
  grant     Grant            @relation(fields: [grantId], references: [id], onDelete: Cascade)
  index     Int
  label     String
  amount    Float?
  dueDate   DateTime?
  status    GrantStageStatus @default(Pending)
  note      String           @default("")
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@index([grantId])
  @@index([status])
}

model MediaDocument {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String
  fileUrl     String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}
